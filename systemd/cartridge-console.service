# /etc/systemd/system/cartridge-console.service
[Unit]
Description=Cartridge console - live USB and import report on tty1
After=local-fs.target getty@tty1.service cartridge-boot-art.service
Wants=getty@tty1.service
# The art clears the screen, so the report must not start before it finishes.
Wants=cartridge-boot-art.service
StartLimitIntervalSec=0

[Service]
Type=simple
ExecStart=/usr/local/bin/cartridge console
Restart=always
RestartSec=3
# A status line is worth nothing next to a request: it redraws with whatever
# the web tier is not using, and re-reads the release tree every few seconds
# instead of on every frame.
Nice=19
CPUWeight=1
IOSchedulingClass=idle

[Install]
WantedBy=multi-user.target
