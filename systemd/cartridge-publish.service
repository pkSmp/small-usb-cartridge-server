[Unit]
Description=Publish the active cartridge release into RAM
After=local-fs.target
ConditionPathExists=/srv/cartridge

[Service]
Type=oneshot
ExecStart=/usr/local/bin/cartridge publish
TimeoutStartSec=10min
# Staging is the critical path to the first request: the web tier waits for
# this copy, so it gets the CPU and the disk back rather than the idle class.
CPUWeight=1000
IOSchedulingClass=best-effort
IOSchedulingPriority=0

[Install]
WantedBy=multi-user.target
