[Unit]
Description=Cartridge web server (Rust)
After=network.target local-fs.target cartridge-publish.service
Wants=cartridge-publish.service
StartLimitIntervalSec=0

[Service]
Type=simple
# 0.0.0.0 serves the LAN directly. In cluster mode set CARTRIDGE_BIND=127.0.0.1
# in /etc/default/cartridge, so cartridge-cluster owns the public ports.
Environment=CARTRIDGE_BIND=0.0.0.0
EnvironmentFile=-/etc/default/cartridge
# --workers 0 means one worker per CPU thread, detected at start.
ExecStart=/usr/local/bin/cartridge web --root /run/cartridge --workers 0 --bind ${CARTRIDGE_BIND}
Restart=always
RestartSec=1
LimitNOFILE=65535
# Answer requests before anything else the box might be doing.
Nice=-10
CPUWeight=10000
IOWeight=10
# Keep the web tier alive before anything else when memory is tight.
OOMScoreAdjust=-200
# It only ever reads the RAM copy; it writes nothing but the pid file at start.
ProtectSystem=strict
ReadOnlyPaths=/run/cartridge /srv/cartridge
ReadWritePaths=/run

[Install]
WantedBy=multi-user.target
